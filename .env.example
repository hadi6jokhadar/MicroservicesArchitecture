# Copy this file to .env and fill in real values — never commit .env
# Generate secure random values for all secrets before use.

# ── Docker Hub (used by docker-compose.yml image: refs and docker/build-and-push.mjs) ─
DOCKERHUB_USERNAME=your_dockerhub_username

# ── PC2 deploy (used by docker/deploy-pc2.mjs, deploy-changed.mjs, build-and-deploy-changed.mjs) ─
# PC2_SSH_HOST must already work as a plain `ssh <value>` — i.e. it matches a Host entry in this
# machine's ~/.ssh/config with a User + IdentityFile already configured. Update this (and your
# ~/.ssh/config entry) if PC2's IP ever changes — nothing else needs to change.
PC2_SSH_HOST=your_pc2_ssh_host_or_ip
PC2_REPO_PATH=/path/to/MicroservicesArchitecture/on/pc2

# ── CORS (single source of truth for the deployment's public hostname — see Doc/DOCKER_DEPLOYMENT_GUIDE.md) ─
# Comma-separated, no spaces. Set this to every real frontend origin for THIS server: admin
# (:4200), nasheed-admin (:4300), nasheed-web (:4301), both http and https if unsure which is
# live, and http://localhost if you test a locally-run Docker frontend image against this
# backend. Update only this value when moving to a new server/hostname.
CORS_EXTRA_ORIGINS=http://your-hostname:4200,https://your-hostname:4200,http://your-hostname:4300,https://your-hostname:4300,http://your-hostname:4301,https://your-hostname:4301,http://localhost:4200,http://localhost:4300,http://localhost:4301

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_REPLICATION_PASSWORD=your_replication_password_here

# ── Redis (docker-compose.redis.yml host-dev-mode instance) ───────────────────
REDIS_PASSWORD=your_redis_password_here

# ── PgAdmin ───────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_pgadmin_password_here

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here
